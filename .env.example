# Copy to .env for local use. Never commit the copy.

# JSON-RPC endpoints. The public ones are used when these are empty.
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# Source verification on the block explorer.
ETHERSCAN_API_KEY=

# Where the monitor posts its report: a Slack-compatible webhook.
MONITOR_WEBHOOK_URL=

# Web app: the chain to talk to (31337 local, 84532 Base Sepolia, 8453 Base) and, optionally, the endpoint.
VITE_CHAIN_ID=
VITE_RPC_URL=
